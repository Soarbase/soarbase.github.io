{
  "id": "./",
  "name": "Soarbase",
  "short_name": "Soarbase",
  "description": "Flight logbook, recorder and 3D replay for glider and light-aircraft pilots",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#12284a",
  "theme_color": "#12284a",
  "categories": ["navigation", "sports", "travel"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Record a flight", "short_name": "Record", "url": "./#/live", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "My flights", "short_name": "Flights", "url": "./#/flights", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Weather", "short_name": "Weather", "url": "./#/weather", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
